# One-off test/debug scripts dropped at the repo root.
# Committed ops scripts live in scripts/ and must stay trackable.
/test-*.js
/check-*.js
/debug-*.js
/reset-*.js
/backfill-*.js
/auto-validate-*.js
/find-*.js
